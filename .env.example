# Paste your Groq Cloud key after the equals sign, then restart the server.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Local retrieval settings; keep this model to reuse the existing index.
VECTORLAB_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTORLAB_SNAPSHOT=data/documents.npz
VECTORLAB_MAX_DISTANCE=0.4
